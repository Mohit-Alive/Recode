# Neon Postgres connection string (pooled). Local Postgres also works.
DATABASE_URL=

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Clerk webhook signing secret for the user.deleted webhook
CLERK_WEBHOOK_SIGNING_SECRET=

# Resend (https://resend.com/api-keys) for daily review reminders
RESEND_API_KEY=
EMAIL_FROM="Recode <reminders@yourdomain.com>"

# Shared secret Vercel Cron sends as a Bearer token
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Keep sign-in on our own routes (used by auth.protect() redirects)
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/today
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/today
